# Copie para .env (na raiz kdp-studio/) e preencha.
# O app carrega este arquivo automaticamente (backend/app/llm.py), tanto em
# `./run.sh` quanto em `uvicorn backend.app.main:app`.
# Sem OPENAI_API_KEY nem GEMINI_API_KEY o app roda em modo offline (mock).
#
# Segurança: mantenha apenas UM .env (na raiz). Não versione este arquivo.
OPENAI_API_KEY=
OPENAI_BASE_URL=
TRANSLATION_MODEL=gpt-4o-mini
CREATION_MODEL=gpt-4o
COVER_MODEL=dall-e-3

# --- Google Gemini (IA generativa, alternativa gratuita ao OpenAI) ---
# Usado automaticamente quando OPENAI_API_KEY esta vazio mas GEMINI_API_KEY preenchido.
# Endpoint OpenAI-compatible: https://generativelanguage.googleapis.com/v1beta/openai/
# Obtenha a chave em: https://aistudio.google.com (API key)
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.0-flash
# Exemplo alternativo (sem GEMINI_API_KEY): aponte o OpenAI-compatible para o Google:
#OPENAI_API_KEY=AIza...
#OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Servidor / limites (opcionais) ---
#HOST=127.0.0.1
#PORT=8000
#RELOAD=1                 # 1 = uvicorn --reload (desenvolvimento)
#MAX_UPLOAD_MB=100        # tamanho maximo de PDF aceito
#CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
#JOB_TTL_SECONDS=7200     # validade dos jobs de conversao em memoria
#JOB_MAX=50               # numero maximo de jobs mantidos
