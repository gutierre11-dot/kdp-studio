# Copie para .env (na raiz kdp-studio/) e preencha — ou rode ./configurar-ia.sh,
# que pergunta a chave, valida com uma chamada real e grava aqui com permissão 600.
#
# Segurança: mantenha apenas UM .env (na raiz) e não o versione.
#
# Prioridade do provider: LLM_PROVIDER (se definido) → DeepSeek → OpenAI → Gemini.

# ---------------------------------------------------------------- DeepSeek
# Recomendado. Crie a chave em https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_FALLBACKS=deepseek-v4-pro
# Modo de raciocínio: desligado por padrão. Ligar multiplica tempo e custo numa
# tradução de livro inteiro, sem ganho proporcional.
DEEPSEEK_THINKING=0

# ------------------------------------------------- OpenAI (ou compatível)
# Vale para OpenRouter, DeepSeek via proxy e qualquer endpoint compatível.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ------------------------------------------------------------------- Gemini
# Endpoint OpenAI-compatible do Google. Obtenha em https://aistudio.google.com
#GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.1-flash-lite

# --------------------------------------------------------------- Forçar provider
# deepseek | openai | gemini | offline
# Use quando houver mais de uma chave no arquivo.
#LLM_PROVIDER=deepseek

# ------------------------------------------------------------------- Tradução
# Override explícito do modelo (ignora a cadeia do provider).
#TRANSLATION_MODEL=
# Caracteres por chamada de tradução e chamadas em paralelo.
TRANSLATION_CHUNK_CHARS=6000
TRANSLATION_WORKERS=4

# -------------------------------------------------------- Resiliência do LLM
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Teto de tempo de UMA chamada de chat, somando todos os modelos e rodadas.
LLM_MAX_TOTAL_SECONDS=180

# --------------------------------------------------------- Servidor e limites
#HOST=127.0.0.1
#PORT=8000
#RELOAD=1                    # 1 = uvicorn --reload (desenvolvimento)
MAX_UPLOAD_MB=100            # tamanho máximo de PDF aceito
#CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
JOB_TTL_SECONDS=7200         # validade dos jobs em memória
JOB_MAX=50                   # máximo de jobs mantidos em memória
JOB_WORKERS=2                # jobs processados em paralelo
