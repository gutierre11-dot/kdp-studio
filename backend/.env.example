# ATENÇÃO: a localização canônica do .env é a RAIZ do projeto (kdp-studio/.env).
# O app carrega, nesta ordem, kdp-studio/.env e depois kdp-studio/backend/.env.
# Mantenha apenas UM arquivo com chaves reais para não duplicar segredos.
#
# Use ../.env.example como base:
#   cp ../.env.example ../.env
#
# Este exemplo em backend/ é apenas uma referência de compatibilidade para o
# formato OpenAI-compatible (OpenAI, OpenRouter, DeepSeek, etc.).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSLATION_MODEL=gpt-4o-mini
CREATION_MODEL=gpt-4o
COVER_MODEL=dall-e-3

# --- Google Gemini (IA generativa, alternativa gratuita ao OpenAI) ---
# Usado automaticamente quando OPENAI_API_KEY esta vazio mas GEMINI_API_KEY preenchido.
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.0-flash
