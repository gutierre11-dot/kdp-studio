# Copie para .env (na raiz kdp-studio/) e preencha.
# O app carrega este arquivo automaticamente (backend/app/config.py), tanto em
# `./run.sh` quanto em `uvicorn backend.app.main:app`.
#
# Segurança: mantenha apenas UM .env (na raiz) e não o versione.

# --- Provider OpenAI (ou compatível: OpenRouter, DeepSeek, ...) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Provider Gemini (endpoint OpenAI-compatible do Google) ---
# Usado automaticamente quando OPENAI_API_KEY está vazio e esta chave existe.
# Obtenha em https://aistudio.google.com (API key).
#GEMINI_API_KEY=
# Modelo primário de tradução. Se ele responder 404/503, a cadeia de fallback
# abaixo assume automaticamente.
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.1-flash-lite

# --- Tradução ---
# Override explícito do modelo (tem prioridade sobre GEMINI_MODEL).
#TRANSLATION_MODEL=
# Caracteres por chamada de tradução e chamadas em paralelo.
TRANSLATION_CHUNK_CHARS=6000
TRANSLATION_WORKERS=4

# --- Resiliência do LLM ---
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# --- Servidor e limites ---
#HOST=127.0.0.1
#PORT=8000
#RELOAD=1                    # 1 = uvicorn --reload (desenvolvimento)
MAX_UPLOAD_MB=100            # tamanho máximo de PDF aceito
#CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
JOB_TTL_SECONDS=7200         # validade dos jobs em memória
JOB_MAX=50                   # máximo de jobs mantidos em memória
JOB_WORKERS=2                # jobs processados em paralelo
